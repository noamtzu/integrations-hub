# Copy to .env and adjust. Every value here is a local-development placeholder.

PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://hub:hub@localhost:5433/hub

# ---- Inbound sources (a source is enabled when its secret is set) ----
# Stripe: the "Signing secret" of your webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=whsec_local_dev_only
# Generic HMAC source: shared secret agreed with the sender.
GENERIC_WEBHOOK_SECRET=generic_local_dev_only
SIGNATURE_TOLERANCE_SECONDS=300

# ---- Worker ----
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=500
WORKER_LEASE_SECONDS=60
MAX_ATTEMPTS=8
BACKOFF_BASE_MS=1000
BACKOFF_MAX_MS=900000
SHUTDOWN_TIMEOUT_MS=25000

# ---- Google Sheets connector (enabled when all three are set) ----
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Events!A:F
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the service account JSON; \n escapes are fine.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_SHEETS_RATE_PER_SECOND=1

# ---- Outbound webhook connector (enabled when the URL is set) ----
# `npm run mock:destination` starts a local receiver on :4000 that fails some requests on purpose.
OUTBOUND_WEBHOOK_URL=http://localhost:4000/hook
OUTBOUND_WEBHOOK_SECRET=outbound_local_dev_only
OUTBOUND_WEBHOOK_RATE_PER_SECOND=5

# ---- Dashboard basic auth (set both outside local development) ----
DASHBOARD_USER=
DASHBOARD_PASSWORD=
